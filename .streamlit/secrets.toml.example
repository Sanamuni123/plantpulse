# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Without this the app runs in demo mode with in-app synthetic data.
[connections.snowflake]
account   = "<orgname-accountname>"
user      = "<user>"
password  = "<password>"
role      = "ACCOUNTADMIN"
warehouse = "PLANTPULSE_WH"
database  = "PLANTPULSE"
schema    = "OPS"
